@model Reservation
@{
    ViewData["Title"] = "DeleteReservations";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Reservation</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Check In Date</dt>
        <dd class="col-sm-10">@Model.CheckInDate</dd>
        <dt class="col-sm-2">Check Out Date</dt>
        <dd class="col-sm-10">@Model.CheckOutDate</dd>
        <dt class="col-sm-2">Package Type</dt>
        <dd class="col-sm-10">@Model.PackageType</dd>
        <dt class="col-sm-2">Total Amount</dt>
        <dd class="col-sm-10">@Model.TotalAmount</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>
        <dt class="col-sm-2">Room</dt>
        <dd class="col-sm-10">@Model.Room?.Description</dd>
        <dt class="col-sm-2">Customer</dt>
        <dd class="col-sm-10">@Model.Customer?.City</dd>
        <dt class="col-sm-2">Master Id</dt>
        <dd class="col-sm-10">@Model.MasterId</dd>
        <dt class="col-sm-2">Created Date</dt>
        <dd class="col-sm-10">@Model.CreatedDate</dd>
        <dt class="col-sm-2">Entry Date</dt>
        <dd class="col-sm-10">@Model.EntryDate</dd>
        <dt class="col-sm-2">Updated Date</dt>
        <dd class="col-sm-10">@Model.UpdatedDate</dd>
        <dt class="col-sm-2">Selected Status</dt>
        <dd class="col-sm-10">@Model.SelectedStatus</dd>
        <dt class="col-sm-2">Updated Computer Name</dt>
        <dd class="col-sm-10">@Model.UpdatedComputerName</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
